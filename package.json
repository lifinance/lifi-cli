{
  "name": "@lifi/cli",
  "version": "0.1.0",
  "description": "CLI for the LI.FI cross-chain bridge & DEX aggregation API",
  "license": "MIT",
  "bin": {
    "lifi": "./dist/lifi.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/lifi.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "axios": "^1.7.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
