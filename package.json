{
  "name": "@lifi/cli",
  "version": "0.1.1-alpha.0",
  "description": "CLI for the LI.FI cross-chain bridge & DEX aggregation API",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lifi": "./dist/lifi.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/lifi.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "release": "commit-and-tag-version -a -s",
    "release:alpha": "commit-and-tag-version -a -s --prerelease alpha",
    "release:beta": "commit-and-tag-version -a -s --prerelease beta"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "axios": "^1.7.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/node": "^22.0.0",
    "commit-and-tag-version": "^12.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsdown": "^0.21.8",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  }
}
